{
  "name": "paragraf",
  "private": true,
  "version": "0.1.0",
  "description": "Paragraf: nauka prawa oparta na przywoływaniu z pamięci i FSRS",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace apps/web",
    "dev": "npm run dev --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p apps/web",
    "e2e": "node e2e/full.mjs && node e2e/features.mjs && node e2e/sync.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "1.56",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
